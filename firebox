#!/usr/bin/env bash
set -euo pipefail

# -------------------------------------------------------------------------
# Argument parsing
# -------------------------------------------------------------------------
VERBOSE=0
SHELL_MODE=0
for arg in "$@"; do
    if [[ "$arg" == "-v" || "$arg" == "--verbose" ]]; then
        VERBOSE=1
    elif [[ "$arg" == "--shell" ]]; then
        SHELL_MODE=1
    fi
done

if (( VERBOSE )); then
    set -x
fi

cd "${HOME:-}" || { echo "Error: HOME environment variable not set." >&2; exit 1; }

# Fall back to the standard per-user runtime dir if unset (set -u safety and
# portability across init systems).
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# -------------------------------------------------------------------------
# URL handling
# -------------------------------------------------------------------------
URL="about:blank"
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose) shift ;;
        --shell) shift ;;
        *) REMAINING_ARGS+=("$1") ; shift ;;
    esac
done

if [[ -n "${REMAINING_ARGS[0]:-}" ]]; then
    case "${REMAINING_ARGS[0]}" in
        http://*|https://*|about:*|file://*)
            URL="${REMAINING_ARGS[0]}" ;;
        *)
            URL="https://${REMAINING_ARGS[0]}" ;;
    esac
fi

# -------------------------------------------------------------------------
# Sandbox preparation
# -------------------------------------------------------------------------
SANDBOXES="/tmp/sandboxes" 
SANDBOX="${SANDBOXES}/firefox"
EPHEMERAL_PROFILE=""
PROXY_PID=""
EXIT_CODE=0
USE_TMPFS=false
TMPFS_RUNTIME=""

# Check if /tmp is tmpfs
tmp_fs_type=$(findmnt -n -o FSTYPE /tmp 2>/dev/null)
if [[ "$tmp_fs_type" != "tmpfs" ]]; then
    echo "[WARNING] /tmp is not mounted as tmpfs."
fi

# Check if /tmp is mounted with noexec
tmp_mount_opts=$(findmnt -n -o OPTIONS /tmp 2>/dev/null)
if [[ ! "$tmp_mount_opts" =~ noexec ]]; then
    echo "[WARNING] /tmp is not mounted with the 'noexec' option."
fi

# Check if SANDBOX is located inside HOME
HOME_CLEAN="${HOME%/}"
if [[ -n "$SANDBOX" ]] && [[ "$SANDBOX" == "${HOME_CLEAN}/"* ]]; then
    echo "[WARNING] \$SANDBOX is located inside \$HOME (${SANDBOX})."
    echo "          This creates security implications. If the sandbox is compromised,"
    echo "          it could potentially escape and access user data."
fi

# -------------------------------------------------------------------------
# Robust cleanup function
# -------------------------------------------------------------------------
_CLEANUP_DONE=0
cleanup() {
    if [[ "$_CLEANUP_DONE" == "1" ]]; then return 0; fi
    _CLEANUP_DONE=1

    local orig_set_e
    orig_set_e=$(set +o | grep errexit) || true
    set +e

    if [[ -n "${PROXY_PID:-}" ]] && kill -0 "$PROXY_PID" 2>/dev/null; then
        kill -TERM "$PROXY_PID" 2>/dev/null || true
        local i=0
        while kill -0 "$PROXY_PID" 2>/dev/null && (( i < 20 )); do
            sleep 0.1
            ((i++))
        done
        kill -9 "$PROXY_PID" 2>/dev/null || true
    fi

    if [[ -n "${TMPFS_RUNTIME:-}" ]] && [[ -d "$TMPFS_RUNTIME" ]]; then
        find "$TMPFS_RUNTIME" -mindepth 1 -delete 2>/dev/null
        rmdir "$TMPFS_RUNTIME" 2>/dev/null
    fi

    if [[ -n "$orig_set_e" ]]; then
        eval "$orig_set_e"
    fi
}

# Trap on EXIT ensures cleanup runs even on script errors (set -e)
trap cleanup EXIT INT TERM HUP

# In shell mode, make Ctrl-C inert. bwrap's --new-session detaches the sandbox
# from the controlling terminal, so a tty interrupt is delivered to *this*
# process group (firebox and bwrap) rather than to the shell inside. bwrap has
# no SIGINT handler, so it would die and drag the whole sandbox down with it.
# Ignoring SIGINT here is inherited through bwrap by the shell, so Ctrl-C no
# longer tears the session down. Leave with `exit` or by closing the terminal.
if (( SHELL_MODE )); then
    trap '' INT
fi

# -------------------------------------------------------------------------
# Dependency check (Soft + Hard)
# -------------------------------------------------------------------------
for cmd in bwrap xdg-dbus-proxy rsync awk file sqlite3 findmnt; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required command '$cmd' not found" >&2
        exit 1
    fi
done

for cmd in uuidgen jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Warning: '$cmd' not available; some features may be degraded." >&2
    fi
done

# -------------------------------------------------------------------------
# Wayland check
# -------------------------------------------------------------------------
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    echo "Error: WAYLAND_DISPLAY is not set. This sandbox requires a Wayland session." >&2
    exit 1
fi

# -------------------------------------------------------------------------
# Unique Runtime Directory
# -------------------------------------------------------------------------
if [[ -d /dev/shm ]]; then
    TMPFS_RUNTIME=$(mktemp -d /dev/shm/firefox-runtime.XXXXXX 2>/dev/null)
    if [[ -n "$TMPFS_RUNTIME" && -d "$TMPFS_RUNTIME" ]]; then
        USE_TMPFS=true
    fi
fi

if [[ "$USE_TMPFS" == false ]]; then
    TMPFS_RUNTIME=$(mktemp -d /tmp/firefox-runtime.XXXXXX 2>/dev/null)
fi

if [[ -z "$TMPFS_RUNTIME" || ! -d "$TMPFS_RUNTIME" ]]; then
    echo "Error: Failed to create runtime directory in /dev/shm or /tmp." >&2
    exit 1
fi
(( VERBOSE )) && echo "Runtime directory created at: $TMPFS_RUNTIME"

if date +%s%N &>/dev/null; then
    EPHEMERAL_PROFILE="${TMPFS_RUNTIME}/profile-$(date +%s%N)"
else
    EPHEMERAL_PROFILE="${TMPFS_RUNTIME}/profile-$(date +%s)-$$-$RANDOM"
fi

# -------------------------------------------------------------------------
# Profile Creation
# -------------------------------------------------------------------------
mkdir -p "$EPHEMERAL_PROFILE"
chmod 700 "$TMPFS_RUNTIME"
chmod -R 700 "$EPHEMERAL_PROFILE"
mkdir -p "$EPHEMERAL_PROFILE"/{.cache,thumbnails,.config/mozilla}

# -------------------------------------------------------------------------
# Source profile detection
# -------------------------------------------------------------------------
SOURCE_PROFILE=""

FIREFOX_DIR="${HOME}/.mozilla/firefox"
PROFILES_INI="${FIREFOX_DIR}/profiles.ini"

if [[ -f "$PROFILES_INI" ]]; then
    # Prefer the profile specified by an [Install...] section.
    SOURCE_PROFILE=$(awk '
        /^\[Install[0-9A-Fa-f]+\]/ {
            in_install=1
            next
        }

        /^\[/ {
            in_install=0
        }

        in_install && /^Default=/ {
            path=$0
            sub(/^Default=/, "", path)
            print path
            exit
        }
    ' "$PROFILES_INI" 2>/dev/null)

    if [[ -n "$SOURCE_PROFILE" && "$SOURCE_PROFILE" != /* ]]; then
        SOURCE_PROFILE="${FIREFOX_DIR}/${SOURCE_PROFILE}"
    fi
fi

# Fall back to the profile marked Default=1.
if [[ -z "$SOURCE_PROFILE" || ! -d "$SOURCE_PROFILE" ]]; then
    SOURCE_PROFILE=$(awk '
        BEGIN {
            in_profile=0
            path=""
            is_default=0
        }

        /^\[Profile[0-9]*\]/ {
            in_profile=1
            path=""
            is_default=0
            next
        }

        /^\[/ {
            in_profile=0
        }

        in_profile && /^Path=/ {
            path=$0
            sub(/^Path=/, "", path)
        }

        in_profile && /^Default=1$/ {
            is_default=1
        }

        in_profile && is_default && path {
            print path
            exit
        }
    ' "$PROFILES_INI" 2>/dev/null)

    if [[ -n "$SOURCE_PROFILE" && "$SOURCE_PROFILE" != /* ]]; then
        SOURCE_PROFILE="${FIREFOX_DIR}/${SOURCE_PROFILE}"
    fi
fi

# Final fallback: find a Firefox profile directory.
if [[ -z "$SOURCE_PROFILE" || ! -d "$SOURCE_PROFILE" ]]; then
    shopt -s nullglob

    for d in \
        "${FIREFOX_DIR}"/*.default-release \
        "${FIREFOX_DIR}"/*.default
    do
        if [[ -d "$d" ]]; then
            SOURCE_PROFILE="$d"
            break
        fi
    done

    shopt -u nullglob
fi

# -------------------------------------------------------------------------
# Guard against a running instance of the source profile
# -------------------------------------------------------------------------
# While running, Firefox holds an fcntl lock on "<profile>/.parentlock" and
# maintains a "lock" symlink of the form "<ip>:[+]<pid>". If that pid is still
# alive the databases may be mid-write, so refuse to copy them rather than risk
# a stale or corrupt places.sqlite.
source_profile_in_use() {
    local profile="$1" target pid
    [[ -n "$profile" && -L "$profile/lock" ]] || return 1
    target=$(readlink -- "$profile/lock" 2>/dev/null) || return 1
    pid="${target##*:}"
    pid="${pid#+}"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null
}

if [[ -n "$SOURCE_PROFILE" ]] && source_profile_in_use "$SOURCE_PROFILE"; then
    echo "Error: Firefox profile '$SOURCE_PROFILE' is currently in use." >&2
    echo "       Close the running Firefox instance and try again." >&2
    exit 1
fi

# -------------------------------------------------------------------------
# Populate extensions and storage
# -------------------------------------------------------------------------
shopt -s nullglob

# 1. Copy Extensions (Binaries) - needed for installed extensions to load
for src in "$SOURCE_PROFILE"/extension*; do
    if [[ -n "$src" && -e "$src" ]]; then
        rsync -a "$src" "$EPHEMERAL_PROFILE/" || echo "Warning: Failed to sync $src" >&2
    fi
done

# 2. Copy Extension Registry (configs only)
if [[ -n "$SOURCE_PROFILE" ]] && [[ -f "$SOURCE_PROFILE/extensions.json" ]]; then
    cp "$SOURCE_PROFILE/extensions.json" "$EPHEMERAL_PROFILE/extensions.json"
fi

# 3. Copy Extension Preferences / Settings (configs only)
for file in \
    extension-preferences.json \
    extension-settings.json
do
    if [[ -f "$SOURCE_PROFILE/$file" ]]; then
        cp "$SOURCE_PROFILE/$file" "$EPHEMERAL_PROFILE/$file"
    fi
done

# Skip browser-extension-data/ and storage/ - only bookmarks and extension configs are carried
shopt -u nullglob

# Safe Bookmark Injection (Sanitized places.sqlite)
# -------------------------------------------------------------------------
