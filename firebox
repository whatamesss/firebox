# Sandbox Dirs
# -------------------------------------------------------------------------
for dir in "$SANDBOX" "$SANDBOX/.local" "$SANDBOX/Downloads" "$SANDBOX/Documents" "$SANDBOX/Pictures" "$SANDBOX/Desktop"; do
    mkdir -p "$dir"
done

# -------------------------------------------------------------------------
# Build Input Method & GPU Env Array
# -------------------------------------------------------------------------
BWRAP_IM=()
if [[ -n "${GTK_IM_MODULE:-}" ]]; then
    BWRAP_IM+=(--setenv GTK_IM_MODULE "$GTK_IM_MODULE")
fi
if [[ -n "${QT_IM_MODULE:-}" ]]; then
    BWRAP_IM+=(--setenv QT_IM_MODULE "$QT_IM_MODULE")
fi
if [[ -n "${XMODIFIERS:-}" ]]; then
    BWRAP_IM+=(--setenv XMODIFIERS "$XMODIFIERS")
fi
if [[ "$HAS_NVIDIA" == true ]]; then
    BWRAP_IM+=(--setenv LIBVA_DRIVER_NAME nvidia)
fi

# -------------------------------------------------------------------------
# User Specific Binds (from ~/.local)
# -------------------------------------------------------------------------

# Ensure target directories exist in the sandbox so we can bind files into them
mkdir -p "$SANDBOX/.local/bin"
mkdir -p "$SANDBOX/.local/share/applications"

BWRAP_USER_BINDS=()

if [[ -f "$HOME/.local/bin/browse.sh" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/bin/browse.sh" "$SANDBOX/.local/bin/browse.sh")
fi
if [[ -f "$HOME/.local/share/applications/mpv-scheme-handler.desktop" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mpv-scheme-handler.desktop" "$SANDBOX/.local/share/applications/mpv-scheme-handler.desktop")
fi
if [[ -f "$HOME/.local/share/applications/my-url-handler.desktop" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/my-url-handler.desktop" "$SANDBOX/.local/share/applications/my-url-handler.desktop")
fi
# Check if it exists as a file OR a link
if [[ -f "$HOME/.local/share/applications/mimeapps.list" || -L "$HOME/.local/share/applications/mimeapps.list" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mimeapps.list" "$SANDBOX/.local/share/applications/mimeapps.list")
fi
if [[ -f "$HOME/.local/share/applications/mimeinfo.cache" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mimeinfo.cache" "$SANDBOX/.local/share/applications/mimeinfo.cache")
fi

# -------------------------------------------------------------------------
# Bwrap command construction
# -------------------------------------------------------------------------
if (( SHELL_MODE )); then
    (( VERBOSE )) && echo "[Info] Shell mode: launching bash inside the sandbox."
    BWRAP_CMD=(bash)
else
    BWRAP_CMD=("$MOZ_LAUNCHER" --no-remote --profile "$EPHEMERAL_PROFILE" "$URL" "${REMAINING_ARGS[@]:1}")
fi

bwrap \
    --die-with-parent \
    --unshare-ipc \
    --unshare-pid \
    --unshare-cgroup \
    --unshare-uts \
    --hostname localhost \
    --new-session \
    --setenv HOME "$SANDBOX" \
    --setenv XDG_CONFIG_HOME "$SANDBOX/.config" \
    --setenv XDG_RUNTIME_DIR "$TMPFS_RUNTIME" \
    --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$TMPFS_RUNTIME/firefox-ephemeral.sock" \
    --setenv NSS_USE_INTERNAL_DB 1 \
    --setenv MOZ_ENABLE_WAYLAND 1 \
    --setenv GTK_USE_PORTAL 1 \
    --setenv PATH "$PATH" \
    --setenv LANG "$SYSTEM_LOCALE" \
    --setenv LC_ALL "$SYSTEM_LOCALE" \
    --setenv TERM "${TERM:-xterm-256color}" \
    --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
    --setenv XDG_DOCUMENTS_DIR "$SANDBOX/Documents" \
    --setenv XDG_DOWNLOAD_DIR "$SANDBOX/Downloads" \
    --setenv XDG_PICTURES_DIR "$SANDBOX/Pictures" \
    --setenv XDG_DESKTOP_DIR "$SANDBOX/Desktop" \
    ${XDG_SESSION_TYPE:+--setenv XDG_SESSION_TYPE "$XDG_SESSION_TYPE"} \
    --setenv XDG_CURRENT_DESKTOP "${XDG_CURRENT_DESKTOP:-GNOME}" \
    --setenv XDG_CONFIG_DIRS "/etc/xdg" \
    --unsetenv KDE_FULL_SESSION \
    --unsetenv KDE_SESSION_VERSION \
    --unsetenv KDE_SESSION_UID \
    --unsetenv KDE_APPLICATIONS_AS_SCOPE \
    --unsetenv _KDE_APPLICATIONS_AS_FORKING \
    --unsetenv KGLOBALACCELD_PLATFORM \
    --unsetenv XDG_MENU_PREFIX \
    --unsetenv LANGUAGE \
    --unsetenv CONFIG_PROTECT_MASK \
    --unsetenv CONFIG_PROTECT \
    --unsetenv PKG_CONFIG_PATH \
    --unsetenv NVD_BACKEND \
    --unsetenv SESSION_MANAGER \
    --unsetenv ICEAUTHORITY \
    ${BWRAP_IM[@]} \
    "${BWRAP_GPU_ENV[@]}" \
    \
    --proc /proc \
    "${BWRAP_PROC_GPU[@]}" \
    --tmpfs /tmp \
    --dev /dev \
    --dev-bind-try /dev/snd /dev/snd \
    --dir /dev/dri \
    "${BWRAP_GPU[@]}" \
    \
    --ro-bind /usr/bin /usr/bin \
    --ro-bind-try /bin /bin \
    "${BWRAP_LIBS[@]}" \
    "${BWRAP_MULTIARCH[@]}" \
    "${BWRAP_GRAPHICS_SHARES[@]}" \
    --ro-bind-try /opt /opt \
    --ro-bind-try /usr/share/X11/xkb /usr/share/X11/xkb \
    --ro-bind-try /usr/share/themes /usr/share/themes \
    --ro-bind-try /usr/share/mime /usr/share/mime \
    --ro-bind-try /usr/share/icons /usr/share/icons \
    --ro-bind-try /usr/share/glib-2.0/schemas /usr/share/glib-2.0/schemas \
    --ro-bind-try /usr/share/applications /usr/share/applications \
    --ro-bind-try /usr/share/locale /usr/share/locale \
    --ro-bind-try /usr/share/fonts /usr/share/fonts \
    --ro-bind-try /usr/share/ca-certificates /usr/share/ca-certificates \
    --ro-bind-try /etc/vulkan /etc/vulkan \
    --ro-bind-try /usr/share/vulkan /usr/share/vulkan \
    \
    --ro-bind-try /etc/ssl /etc/ssl \
    --ro-bind-try /etc/resolv.conf /etc/resolv.conf \
    --ro-bind "$TMPFS_RUNTIME/passwd" /etc/passwd \
    --ro-bind "$TMPFS_RUNTIME/group" /etc/group \
    --ro-bind "$TMPFS_RUNTIME/hosts" /etc/hosts \
    --ro-bind "$TMPFS_RUNTIME/machine-id" /etc/machine-id \
    --ro-bind "$TMPFS_RUNTIME/os-release" /etc/os-release \
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf \
    "${BWRAP_PRINT[@]}" \
    --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache \
    --ro-bind-try /etc/ld.so.conf /etc/ld.so.conf \
    --ro-bind-try /etc/ld.so.conf.d /etc/ld.so.conf.d \
    --ro-bind-try /etc/fonts /etc/fonts \
    --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig \
    \
    "${BWRAP_SYS[@]}" \
    \
    --ro-bind "$MOZ_INSTALL_DIR" "$MOZ_INSTALL_DIR" \
    "${BWRAP_OVERRIDES[@]}" \
    \
    --ro-bind-try "$TMPFS_RUNTIME/flatpak-info" "/.flatpak-info" \
    --ro-bind-try /etc/localtime /etc/localtime \
    --ro-bind-try /usr/share/zoneinfo /usr/share/zoneinfo \
    --tmpfs "$SANDBOX/.config" \
    "${BWRAP_USER_BINDS[@]}" \
    --bind "$SANDBOX/Downloads" "$SANDBOX/Downloads" \
    --bind "$SANDBOX/Documents" "$SANDBOX/Documents" \
    --bind "$SANDBOX/Pictures" "$SANDBOX/Pictures" \
    --bind "$SANDBOX/Desktop" "$SANDBOX/Desktop" \
    --bind "$TMPFS_RUNTIME" "$TMPFS_RUNTIME" \
    --bind "$EPHEMERAL_PROFILE" "$EPHEMERAL_PROFILE" \
    \
    "${BWRAP_WAYLAND[@]}" \
    "${BWRAP_AV[@]}" \
    \
    --chdir "$SANDBOX" \
    "${BWRAP_CMD[@]}"

EXIT_CODE=$?
exit $EXIT_CODE
