    "$EPHEMERAL_PROFILE/cookies.sqlite" \
    "$EPHEMERAL_PROFILE/logins.json" \
    "$EPHEMERAL_PROFILE/formhistory.sqlite" \
    "$EPHEMERAL_PROFILE/favicons.sqlite" \
