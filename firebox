    exit 1
fi

# -------------------------------------------------------------------------
# Determine Firefox Binary and Wrapper
# -------------------------------------------------------------------------
MOZ_INSTALL_DIR=""
MOZ_LAUNCHER=""

detect_firefox() {
    local candidates=()
    command -v firefox &>/dev/null && candidates+=("$(command -v firefox)")
    command -v firefox-esr &>/dev/null && candidates+=("$(command -v firefox-esr)")
    command -v firefox-bin &>/dev/null && candidates+=("$(command -v firefox-bin)")

    local cmd_path resolved_path file_type is_wrapper found_binary bin_path
    for cmd_path in "${candidates[@]}"; do
        [[ -e "$cmd_path" ]] || continue

        resolved_path="$cmd_path"
        [[ -L "$resolved_path" ]] && resolved_path=$(readlink -f "$resolved_path")
        [[ -n "$resolved_path" && -x "$resolved_path" ]] || resolved_path="$cmd_path"

        file_type=$(file -b "$resolved_path")
        is_wrapper=false
        if [[ "$file_type" == *"script"* || "$file_type" == *"text"* ]]; then
            is_wrapper=true
        fi

        # A real (non-wrapper) binary resolved from PATH is authoritative.
        if [[ "$is_wrapper" == false ]]; then
            MOZ_INSTALL_DIR=$(dirname "$resolved_path")
            MOZ_LAUNCHER="$resolved_path"
            return 0
        fi

        # Otherwise search well-known locations, preferring ones next to the
        # resolved wrapper before falling back to the fixed list.
        found_binary=""
        local search_paths=(
            "$(dirname "$resolved_path")/firefox"
            "$(dirname "$cmd_path")/firefox"
            "/usr/lib64/firefox/firefox"
            "/usr/lib/firefox/firefox"
            "/opt/firefox/firefox-bin"
            "/opt/firefox-bin/firefox"
            "/usr/lib/firefox-esr/firefox-esr"
            "/usr/local/lib/firefox/firefox"
            "/opt/firefox/firefox"
        )

        for bin_path in "${search_paths[@]}"; do
            [[ -n "$bin_path" ]] || continue
            # Never select the wrapper script itself as the binary.
            [[ "$bin_path" == "$resolved_path" || "$bin_path" == "$cmd_path" ]] && continue
            if [[ -x "$bin_path" ]]; then
                found_binary="$bin_path"
                break
            fi
        done

        if [[ -n "$found_binary" ]]; then
            MOZ_INSTALL_DIR=$(dirname "$found_binary")
            MOZ_LAUNCHER="$cmd_path"
            return 0
        fi
    done
    return 1
}

