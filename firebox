    elif command -v xxd &>/dev/null; then
        machine_id=$(head -c 16 /dev/urandom | xxd -p -c 16)
    elif command -v hexdump &>/dev/null; then
        machine_id=$(head -c 16 /dev/urandom | hexdump -ve '1/1 "%02x"')
    else
        machine_id=$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | base64 | tr -d '=+/\n' | cut -c1-32)
    fi
else
    machine_id=$(date +%s%N 2>/dev/null | sha256sum 2>/dev/null | awk '{print $1}' | cut -c1-32)
