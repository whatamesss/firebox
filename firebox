    sqlite3 "$EPHEMERAL_PROFILE/places.sqlite" <<EOSQL
        DELETE FROM moz_historyvisits;
        DELETE FROM moz_inputhistory;
        DELETE FROM moz_places
            WHERE id NOT IN (SELECT fk FROM moz_bookmarks WHERE fk IS NOT NULL);
        UPDATE moz_places SET frecency = -1;
        UPDATE moz_places SET visit_count = 0;
        VACUUM;
EOSQL
    (( VERBOSE )) && echo "Bookmarks injected (History sanitized)."
fi

# Purge sensitive auth/cookie/autofill data - only bookmarks and extension configs retained
