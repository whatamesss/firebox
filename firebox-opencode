#!/usr/bin/env bash
set -euo pipefail

# -------------------------------------------------------------------------
# firebox-opencode — hardened bubblewrap sandbox for opencode
#
# opencode's HOME is the real home directory, so its self-managed install tree
# at ~/.opencode (the curl installer writes $HOME/.opencode/bin) is respected
# and in-sandbox upgrades land where the running binary actually is. It starts
# in the directory you invoked the launcher from (when that directory is inside
# ~/projects). The sandbox starts from an empty root and only exposes:
#   * read-only system trees (libs, certs, timezone, toolchains, ...)
#   * synthesized /etc/passwd, /etc/group, /etc/hosts and /etc/machine-id
#   * /tmp backed by a dedicated host directory (/tmp/opencode), plus a
#     private, ephemeral /dev/shm which also backs TMPDIR (Bun unpacks its
#     native renderer into $TMPDIR and dlopen()s it, so executable payloads
#     must live on a per-session tmpfs, never in the shared /tmp)
#   * read-write, persistent access to exactly:
#       ~/.opencode
#       ~/.config/opencode
#       ~/.cache/opencode
#       ~/.local/share/opencode
#       ~/.local/state/opencode
#       ~/projects            (mounted at /projects)
#   * read-only access to ~/.gitconfig (if present)
#   * read-only access to the Hugging Face model cache at ~/.cache/huggingface
#     (if present; shared caches are readable but never writable from here)
#   * no Wayland, no D-Bus, no GPU, no audio, no X11, no desktop portals.
# -------------------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage: firebox-opencode [OPTIONS] [--] [OPENCODE_ARGS...]

Options:
  -v, --verbose   Show commands as they run
      --no-proxy  Ignore proxychains and connect directly
  -h, --help      Show this help and exit
  --              Treat all remaining arguments as opencode arguments

All other arguments are forwarded to opencode.
EOF
}

# -------------------------------------------------------------------------
# Argument parsing
# -------------------------------------------------------------------------
VERBOSE=0
NO_PROXY=0
OPENCODE_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose) VERBOSE=1; shift ;;
        --no-proxy)   NO_PROXY=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; OPENCODE_ARGS+=("$@"); break ;;
        *)            OPENCODE_ARGS+=("$1"); shift ;;
    esac
done

if (( VERBOSE )); then
    set -x
fi

# -------------------------------------------------------------------------
# Paths / sanity
# -------------------------------------------------------------------------
REAL_HOME="${HOME%/}"
if [[ -z "$REAL_HOME" || ! -d "$REAL_HOME" ]]; then
    echo "Error: HOME environment variable not set or invalid." >&2
    exit 1
fi

PROJECTS_DIR="$REAL_HOME/projects"
EXIT_CODE=0
REAL_USER="${USER:-$(whoami)}"

# Pick an available UTF-8 locale to prevent bash/locale warnings regardless of
# system config. C.UTF-8 is built into modern glibc but absent on older/musl
# systems, so fall back gracefully.
SYSTEM_LOCALE=""
for loc in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    if locale -a 2>/dev/null | grep -qix "${loc//./\\.}"; then
        SYSTEM_LOCALE="$loc"
        break
    fi
done
SYSTEM_LOCALE="${SYSTEM_LOCALE:-C}"
(( VERBOSE )) && echo "System Locale set to: $SYSTEM_LOCALE"

# Synthetic /etc/passwd and /etc/group (never the host's), so the sandbox
# exposes only the launching user and no real host account list.
OPENCODE_RUNTIME=""
if [[ -d /dev/shm ]]; then
    OPENCODE_RUNTIME=$(mktemp -d /dev/shm/opencode-runtime.XXXXXX 2>/dev/null || true)
fi
if [[ -z "$OPENCODE_RUNTIME" ]]; then
    OPENCODE_RUNTIME=$(mktemp -d /tmp/opencode-runtime.XXXXXX 2>/dev/null || true)
fi
if [[ -z "$OPENCODE_RUNTIME" || ! -d "$OPENCODE_RUNTIME" ]]; then
    echo "Error: Failed to create runtime directory in /dev/shm or /tmp." >&2
    exit 1
fi
cleanup() {
    if [[ -n "${OPENCODE_RUNTIME:-}" && -d "$OPENCODE_RUNTIME" ]]; then
        rm -rf "$OPENCODE_RUNTIME"
    fi
    return 0
}
# Signal traps must exit explicitly; otherwise bash resumes the script after
# cleanup has already removed the runtime dir and its bind-mount sources.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP

printf '%s:x:%s:%s:%s:%s:/bin/false\n' \
    "$REAL_USER" "$(id -u)" "$(id -g)" "$REAL_USER" "$REAL_HOME" > "$OPENCODE_RUNTIME/passwd"
printf '%s:x:%s:\n' "$REAL_USER" "$(id -g)" > "$OPENCODE_RUNTIME/group"

# Random per-session machine-id (never the host's persistent identifier).
machine_id=""
if [[ -r /dev/urandom ]]; then
    if command -v od &>/dev/null; then
        machine_id=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
    elif command -v xxd &>/dev/null; then
        machine_id=$(head -c 16 /dev/urandom | xxd -p -c 16)
    elif command -v hexdump &>/dev/null; then
        machine_id=$(head -c 16 /dev/urandom | hexdump -ve '1/1 "%02x"')
    else
        machine_id=$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | base64 | tr -d '=+/\n' | cut -c1-32)
    fi
else
    machine_id=$(date +%s%N 2>/dev/null | sha256sum 2>/dev/null | awk '{print $1}' | cut -c1-32)
fi
[[ -z "$machine_id" ]] && machine_id="00000000000000000000000000000000"
printf '%s\n' "$machine_id" > "$OPENCODE_RUNTIME/machine-id"

# Synthetic /etc/hosts: localhost plus any host 0.0.0.0 blocks, without
# exposing the rest of the host's hostname map.
{
    echo "127.0.0.1 localhost"
    echo "::1 localhost"
    grep -E '^\s*0\.0\.0\.0\s' /etc/hosts 2>/dev/null || true
} > "$OPENCODE_RUNTIME/hosts"

# Copy the DNS configuration to avoid a dangling symlink when /etc/resolv.conf
# points into a directory that is not mounted in the sandbox.
if [[ -L /etc/resolv.conf ]]; then
    RESOLV_TARGET=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
    if [[ -n "$RESOLV_TARGET" && -r "$RESOLV_TARGET" ]]; then
        cp "$RESOLV_TARGET" "$OPENCODE_RUNTIME/resolv.conf" 2>/dev/null || true
    fi
fi
if [[ ! -f "$OPENCODE_RUNTIME/resolv.conf" && -r /etc/resolv.conf ]]; then
    cp /etc/resolv.conf "$OPENCODE_RUNTIME/resolv.conf" 2>/dev/null || true
fi
[[ -f "$OPENCODE_RUNTIME/resolv.conf" ]] && chmod 644 "$OPENCODE_RUNTIME/resolv.conf" 2>/dev/null || true
if [[ ! -f "$OPENCODE_RUNTIME/resolv.conf" ]]; then
    echo "[WARNING] Could not copy /etc/resolv.conf; DNS inside the sandbox may fail." >&2
fi

# TUI keybind overlay: drop Ctrl-C from both app_exit and input_clear so it
# can no longer quit or clear the prompt; leave the session with /quit (or
# ctrl+x q). The file is written locally just below and bind-mounted
# read-only as /etc/opencode-tui.json; it is never fetched from the network.
# Injected via OPENCODE_TUI_CONFIG, which opencode merges on top of the normal
# tui.json. No "$schema" URL is included so nothing points at a remote
# resource at launch.
cat > "$OPENCODE_RUNTIME/tui.json" << 'EOF'
{
  "keybinds": {
    "app_exit": "ctrl+d,<leader>q",
    "input_clear": "none"
  }
}
EOF

# Host directories that must exist. PERSISTENT_DIRS are bound read-write.
PERSISTENT_DIRS=(
    "$REAL_HOME/.opencode"
    "$REAL_HOME/.config/opencode"
    "$REAL_HOME/.cache/opencode"
    "$REAL_HOME/.local/share/opencode"
    "$REAL_HOME/.local/state/opencode"
    "$PROJECTS_DIR"
)
for dir in "${PERSISTENT_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "Error: Required directory '$dir' not found." >&2
        exit 1
    fi
done

# -------------------------------------------------------------------------
# Dependency check
# -------------------------------------------------------------------------
if ! command -v bwrap &>/dev/null; then
    echo "Error: Required command 'bwrap' not found" >&2
    exit 1
fi

if ! command -v opencode &>/dev/null \
   && [[ ! -x "$REAL_HOME/.opencode/bin/opencode" ]]; then
    echo "Error: Required command 'opencode' not found (expected in PATH or at ~/.opencode/bin/opencode)." >&2
    exit 1
fi

# proxychains is optional (named proxychains4 on Debian/Ubuntu).
PROXYCHAINS_BIN=""
if (( ! NO_PROXY )); then
    for pc in proxychains proxychains4; do
        if command -v "$pc" &>/dev/null; then
            PROXYCHAINS_BIN="$pc"
            break
        fi
    done
fi

PROXYCHAINS_CONF=""
if [[ -n "$PROXYCHAINS_BIN" ]]; then
    for pc_conf in /etc/proxychains.conf /etc/proxychains4.conf; do
        if [[ -f "$pc_conf" ]]; then
            PROXYCHAINS_CONF="$pc_conf"
            break
        fi
    done
elif (( NO_PROXY )); then
    (( VERBOSE )) && echo "[Info] proxychains disabled via --no-proxy." >&2
else
    echo "Warning: 'proxychains' not found; running without proxy chaining." >&2
fi

# -------------------------------------------------------------------------
# Scratch space
#
# The sandbox's /tmp is a bind of the host's /tmp/opencode: a dedicated
# directory, created here with mode 700. The host's /tmp is a tmpfs, so the
# contents never reach the disk, but they survive between sessions and can be
# inspected from outside the sandbox. The host's real /tmp stays hidden.
#
# Only non-executable scratch belongs here. TMPDIR is redirected to the
# private, per-session /dev/shm below, because Bun extracts its OpenTUI
# renderer to $TMPDIR and dlopen()s it. A shared, persistent TMPDIR can hand a
# later session a stale or partially written .so, which the loader rejects with
# "failed to map segment from shared object"; /dev/shm disappears with the
# sandbox, so that cannot happen there.
# -------------------------------------------------------------------------
OPENCODE_TMP="/tmp/opencode"
if [[ -L "$OPENCODE_TMP" ]]; then
    echo "Error: '$OPENCODE_TMP' is a symlink; refusing to use it." >&2
    exit 1
fi
if [[ -e "$OPENCODE_TMP" && ! -d "$OPENCODE_TMP" ]]; then
    echo "Error: '$OPENCODE_TMP' exists and is not a directory." >&2
    exit 1
fi
if [[ -d "$OPENCODE_TMP" && "$(stat -c %u "$OPENCODE_TMP")" != "$(id -u)" ]]; then
    echo "Error: '$OPENCODE_TMP' is not owned by the current user." >&2
    exit 1
fi
mkdir -p "$OPENCODE_TMP"
chmod 700 "$OPENCODE_TMP"

# -------------------------------------------------------------------------
# Working directory: ~/projects (or the subfolder the launcher was run from)
# -------------------------------------------------------------------------
CALLER_PWD="${PWD:-$PROJECTS_DIR}"
if [[ "$CALLER_PWD" == "$PROJECTS_DIR" ]]; then
    SANDBOX_CWD="/projects"
elif [[ "$CALLER_PWD" == "$PROJECTS_DIR/"* ]]; then
    SANDBOX_CWD="/projects/${CALLER_PWD#"$PROJECTS_DIR/"}"
else
    SANDBOX_CWD="/projects"
fi

# -------------------------------------------------------------------------
# Read-only system binds
# -------------------------------------------------------------------------
BWRAP_LIBS=(
    --ro-bind /usr/bin /usr/bin
    --ro-bind-try /usr/libexec/git-core /usr/libexec/git-core
    --ro-bind-try /bin /bin
    --ro-bind-try /sbin /sbin
    --ro-bind-try /usr/sbin /usr/sbin
    --ro-bind-try /usr/local /usr/local
    --ro-bind-try /opt /opt
    --ro-bind-try /usr/lib /usr/lib
    --ro-bind-try /usr/lib64 /usr/lib64
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /usr/lib/locale /usr/lib/locale
)
# Preserve /lib across merged-/usr (symlink) and split-/usr (real dir) layouts.
if [[ -L /lib ]]; then
    BWRAP_LIBS+=(--symlink "$(readlink /lib)" /lib)
elif [[ -d /lib ]]; then
    BWRAP_LIBS+=(--ro-bind /lib /lib)
fi

BWRAP_MULTIARCH=()
shopt -s nullglob
for arch_dir in /usr/lib/*-linux-gnu; do
    [[ -d "$arch_dir" ]] && BWRAP_MULTIARCH+=(--ro-bind "$arch_dir" "$arch_dir")
done
shopt -u nullglob

BWRAP_RESOLV=()
if [[ -f "$OPENCODE_RUNTIME/resolv.conf" ]]; then
    BWRAP_RESOLV+=(--ro-bind "$OPENCODE_RUNTIME/resolv.conf" /etc/resolv.conf)
else
    BWRAP_RESOLV+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf)
fi

BWRAP_ETC=(
    --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache
    --ro-bind-try /etc/ld.so.conf /etc/ld.so.conf
    --ro-bind-try /etc/ld.so.conf.d /etc/ld.so.conf.d
    --ro-bind-try /etc/ssl /etc/ssl
    --ro-bind-try /etc/pki /etc/pki
    --ro-bind-try /etc/ca-certificates /etc/ca-certificates
    "${BWRAP_RESOLV[@]}"
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind "$OPENCODE_RUNTIME/hosts" /etc/hosts
    --ro-bind "$OPENCODE_RUNTIME/machine-id" /etc/machine-id
    --ro-bind-try /etc/localtime /etc/localtime
    --ro-bind-try /etc/terminfo /etc/terminfo
    --ro-bind-try /etc/inputrc /etc/inputrc
    --ro-bind-try /etc/profile /etc/profile
    --ro-bind-try /etc/profile.d /etc/profile.d
    --ro-bind-try /etc/bash.bashrc /etc/bash.bashrc
    --ro-bind-try /etc/gitconfig /etc/gitconfig
    --ro-bind "$OPENCODE_RUNTIME/passwd" /etc/passwd
    --ro-bind "$OPENCODE_RUNTIME/group" /etc/group
    --ro-bind "$OPENCODE_RUNTIME/tui.json" /etc/opencode-tui.json
)

# Bind proxychains' config at its native path so the binary finds it.
if [[ -n "$PROXYCHAINS_CONF" ]]; then
    BWRAP_ETC+=(--ro-bind "$PROXYCHAINS_CONF" "$PROXYCHAINS_CONF")
fi

BWRAP_SHARE=(
    --ro-bind-try /usr/share/zoneinfo /usr/share/zoneinfo
    --ro-bind-try /usr/share/git-core /usr/share/git-core
    --ro-bind-try /usr/share/locale /usr/share/locale
    --ro-bind-try /usr/share/terminfo /usr/share/terminfo
    --ro-bind-try /usr/share/misc /usr/share/misc
    --ro-bind-try /usr/share/ca-certificates /usr/share/ca-certificates
)

# -------------------------------------------------------------------------
# Minimal /sys (CPU topology only; no hardware enumeration)
# -------------------------------------------------------------------------
BWRAP_SYS=(
    --tmpfs /sys
    --ro-bind-try /sys/devices/system/cpu /sys/devices/system/cpu
)

# -------------------------------------------------------------------------
# Persistent, read-write binds
# -------------------------------------------------------------------------
BWRAP_RW=(
    --bind "$PROJECTS_DIR" "/projects"
    --bind "$OPENCODE_TMP" "/tmp"
    --bind "$REAL_HOME/.opencode" "$REAL_HOME/.opencode"
    --bind "$REAL_HOME/.config/opencode" "$REAL_HOME/.config/opencode"
    --bind "$REAL_HOME/.cache/opencode" "$REAL_HOME/.cache/opencode"
    --bind "$REAL_HOME/.local/share/opencode" "$REAL_HOME/.local/share/opencode"
    --bind "$REAL_HOME/.local/state/opencode" "$REAL_HOME/.local/state/opencode"
)

# Read-only convenience: git identity, if present. HOME is the real home
# again, so git would find ~/.gitconfig anyway; GIT_CONFIG_GLOBAL is set
# explicitly so the lookup does not depend on HOME resolution.
BWRAP_GITCONFIG=()
BWRAP_GITENV=()
if [[ -f "$REAL_HOME/.gitconfig" ]]; then
    BWRAP_GITCONFIG+=(--ro-bind "$REAL_HOME/.gitconfig" "$REAL_HOME/.gitconfig")
    BWRAP_GITENV+=(--setenv GIT_CONFIG_GLOBAL "$REAL_HOME/.gitconfig")
fi

# Optional read-only model cache. It may be shared with other local ML tools, so
# the sandbox can read it but never modify it. Only bind it when it exists, so
# first-run launches without a cache keep working.
BWRAP_HF_CACHE=()
if [[ -d "$REAL_HOME/.cache/huggingface" ]]; then
    BWRAP_HF_CACHE+=(--ro-bind "$REAL_HOME/.cache/huggingface" "$REAL_HOME/.cache/huggingface")
fi

# -------------------------------------------------------------------------
# Bwrap command construction
#
# OpenCode 2.x normally drives a "background service" whose url/pid/port are
# recorded in ~/.local/state/opencode/service.json. The port is fixed, the
# record persists across sessions (that directory is bind-mounted above), and
# the service itself dies with the sandbox (--die-with-parent). Every launch
# therefore inherits a record pointing at a service that no longer exists: the
# client spends a fixed ~5s reaping it before starting its own, and a second
# concurrent session collides on the same port. A per-session sandbox wants
# neither, so run with a private in-process server (--standalone) instead.
# Not added twice if the caller already passed the flag.
# -------------------------------------------------------------------------
OPENCODE_FLAGS=(--standalone)
for arg in "${OPENCODE_ARGS[@]+"${OPENCODE_ARGS[@]}"}"; do
    if [[ "$arg" == "--standalone" ]]; then
        OPENCODE_FLAGS=()
        break
    fi
done

if [[ -n "$PROXYCHAINS_BIN" ]]; then
    BWRAP_CMD=("$PROXYCHAINS_BIN" -q opencode "${OPENCODE_FLAGS[@]+"${OPENCODE_FLAGS[@]}"}" "${OPENCODE_ARGS[@]+"${OPENCODE_ARGS[@]}"}")
else
    BWRAP_CMD=(opencode "${OPENCODE_FLAGS[@]+"${OPENCODE_FLAGS[@]}"}" "${OPENCODE_ARGS[@]+"${OPENCODE_ARGS[@]}"}")
fi

bwrap \
    --die-with-parent \
    --unshare-ipc \
    --unshare-pid \
    --unshare-cgroup \
    --unshare-uts \
    --hostname localhost \
    --new-session \
    \
    --proc /proc \
    --dev /dev \
    --dev-bind-try /dev/pts /dev/pts \
    --tmpfs /dev/shm \
    --dir "/run/user/$(id -u)" \
    --chmod 700 "/run/user/$(id -u)" \
    \
    "${BWRAP_SYS[@]}" \
    "${BWRAP_LIBS[@]}" \
    "${BWRAP_MULTIARCH[@]}" \
    "${BWRAP_SHARE[@]}" \
    "${BWRAP_ETC[@]}" \
    \
    --setenv HOME "$REAL_HOME" \
    --setenv XDG_CONFIG_HOME "$REAL_HOME/.config" \
    --setenv XDG_DATA_HOME "$REAL_HOME/.local/share" \
    --setenv XDG_CACHE_HOME "$REAL_HOME/.cache" \
    --setenv XDG_STATE_HOME "$REAL_HOME/.local/state" \
    --setenv XDG_CONFIG_DIRS "/etc/xdg" \
    --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)" \
    --setenv PATH "$REAL_HOME/.opencode/bin:$PATH" \
    --setenv OPENCODE_TUI_CONFIG "/etc/opencode-tui.json" \
    --setenv LANG "$SYSTEM_LOCALE" \
    --setenv LC_ALL "$SYSTEM_LOCALE" \
    --setenv TMPDIR "/dev/shm" \
    --setenv BUN_TMPDIR "/dev/shm" \
    --setenv TERM "${TERM:-xterm-256color}" \
    --setenv USER "$REAL_USER" \
    --setenv LOGNAME "$REAL_USER" \
    --setenv SHELL "/bin/bash" \
    --unsetenv DISPLAY \
    --unsetenv WAYLAND_DISPLAY \
    --unsetenv XAUTHORITY \
    --unsetenv DBUS_SESSION_BUS_ADDRESS \
    --unsetenv PULSE_SERVER \
    --unsetenv PIPEWIRE_REMOTE \
    --unsetenv PIPEWIRE_RUNTIME_DIR \
    --unsetenv SSH_AUTH_SOCK \
    --unsetenv GNUPGHOME \
    --unsetenv GPG_AGENT_INFO \
    --unsetenv SESSION_MANAGER \
    --unsetenv ICEAUTHORITY \
    --unsetenv KDE_FULL_SESSION \
    --unsetenv KDE_SESSION_VERSION \
    --unsetenv KDE_SESSION_UID \
    --unsetenv KDE_APPLICATIONS_AS_SCOPE \
    --unsetenv _KDE_APPLICATIONS_AS_FORKING \
    --unsetenv KGLOBALACCELD_PLATFORM \
    --unsetenv XDG_MENU_PREFIX \
    --unsetenv LANGUAGE \
    --unsetenv CONFIG_PROTECT_MASK \
    --unsetenv CONFIG_PROTECT \
    --unsetenv PKG_CONFIG_PATH \
    --unsetenv NVD_BACKEND \
    --unsetenv LD_PRELOAD \
    --unsetenv PROXYCHAINS_CONF_FILE \
    --unsetenv PROXYCHAINS_QUIET_MODE \
    \
    "${BWRAP_RW[@]}" \
    "${BWRAP_GITCONFIG[@]}" \
    "${BWRAP_HF_CACHE[@]}" \
    "${BWRAP_GITENV[@]}" \
    \
    --chdir "$SANDBOX_CWD" \
    "${BWRAP_CMD[@]}" || EXIT_CODE=$?
exit "$EXIT_CODE"
