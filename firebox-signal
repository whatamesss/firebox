#!/usr/bin/env bash
set -euo pipefail
if pgrep -x signal-desktop >/dev/null; then
    exit 0
fi
# -------------------------------------------------------------------------
# Argument parsing
# -------------------------------------------------------------------------
VERBOSE=0
for arg in "$@"; do
    if [[ "$arg" == "-v" || "$arg" == "--verbose" ]]; then
        VERBOSE=1
    fi
done

if (( VERBOSE )); then
    set -x
fi

cd "${HOME:-}" || { echo "Error: HOME environment variable not set." >&2; exit 1; }

# -------------------------------------------------------------------------
# URL handling
# -------------------------------------------------------------------------
URL="about:blank"
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose) shift ;;
        *) REMAINING_ARGS+=("$1") ; shift ;;
    esac
done

if [[ -n "${REMAINING_ARGS[0]:-}" ]]; then
    case "${REMAINING_ARGS[0]}" in
        http://*|https://*|about:*|file://*)
            URL="${REMAINING_ARGS[0]}" ;;
        *)
            URL="https://${REMAINING_ARGS[0]}" ;;
    esac
fi

# -------------------------------------------------------------------------
# Sandbox preparation
# -------------------------------------------------------------------------
SANDBOXES="/tmp/sandboxes" 
SANDBOX="${SANDBOXES}/signal"
EPHEMERAL_PROFILE=""
PROXY_PID=""
EXIT_CODE=0
USE_TMPFS=false
TMPFS_RUNTIME=""

# Check if /tmp is tmpfs
tmp_fs_type=$(findmnt -n -o FSTYPE /tmp 2>/dev/null)
if [[ "$tmp_fs_type" != "tmpfs" ]]; then
    echo "[WARNING] /tmp is not mounted as tmpfs."
fi

# Check if /tmp is mounted with noexec
tmp_mount_opts=$(findmnt -n -o OPTIONS /tmp 2>/dev/null)
if [[ ! "$tmp_mount_opts" =~ noexec ]]; then
    echo "[WARNING] /tmp is not mounted with the 'noexec' option."
fi

# Check if SANDBOX is located inside HOME
HOME_CLEAN="${HOME%/}"
if [[ -n "$SANDBOX" ]] && [[ "$SANDBOX" == "${HOME_CLEAN}/"* ]]; then
    echo "[WARNING] \$SANDBOX is located inside \$HOME (${SANDBOX})."
    echo "          This creates security implications. If the sandbox is compromised,"
    echo "          it could potentially escape and access user data."
fi

# -------------------------------------------------------------------------
# Robust cleanup function
# -------------------------------------------------------------------------
_CLEANUP_DONE=0
cleanup() {
    if [[ "$_CLEANUP_DONE" == "1" ]]; then return 0; fi
    _CLEANUP_DONE=1

    local orig_set_e
    orig_set_e=$(set +o | grep errexit) || true
    set +e

    if [[ -n "${PROXY_PID:-}" ]] && kill -0 "$PROXY_PID" 2>/dev/null; then
        kill -TERM "$PROXY_PID" 2>/dev/null || true
        local i=0
        while kill -0 "$PROXY_PID" 2>/dev/null && (( i < 20 )); do
            sleep 0.1
            ((i++))
        done
        kill -9 "$PROXY_PID" 2>/dev/null || true
    fi

    if [[ -n "${TMPFS_RUNTIME:-}" ]] && [[ -d "$TMPFS_RUNTIME" ]]; then
        find "$TMPFS_RUNTIME" -mindepth 1 -delete 2>/dev/null
        rmdir "$TMPFS_RUNTIME" 2>/dev/null
    fi

    if [[ -n "$orig_set_e" ]]; then
        eval "$orig_set_e"
    fi
}

# Trap on EXIT ensures cleanup runs even on script errors (set -e)
trap cleanup EXIT INT TERM HUP

# -------------------------------------------------------------------------
# Dependency check (Soft + Hard)
# -------------------------------------------------------------------------
for cmd in bwrap xdg-dbus-proxy findmnt; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required command '$cmd' not found" >&2
        exit 1
    fi
done

for cmd in uuidgen jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Warning: '$cmd' not available; some features may be degraded." >&2
    fi
done

# -------------------------------------------------------------------------
# Wayland check
# -------------------------------------------------------------------------
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    echo "Error: WAYLAND_DISPLAY is not set. This sandbox requires a Wayland session." >&2
    exit 1
fi

# -------------------------------------------------------------------------
# Unique Runtime Directory
# -------------------------------------------------------------------------
if [[ -d /dev/shm ]]; then
    TMPFS_RUNTIME=$(mktemp -d /dev/shm/signal-runtime.XXXXXX 2>/dev/null)
    if [[ -n "$TMPFS_RUNTIME" && -d "$TMPFS_RUNTIME" ]]; then
        USE_TMPFS=true
    fi
fi

if [[ "$USE_TMPFS" == false ]]; then
    TMPFS_RUNTIME=$(mktemp -d /tmp/signal-runtime.XXXXXX 2>/dev/null)
fi

if [[ -z "$TMPFS_RUNTIME" || ! -d "$TMPFS_RUNTIME" ]]; then
    echo "Error: Failed to create runtime directory in /dev/shm or /tmp." >&2
    exit 1
fi
(( VERBOSE )) && echo "Runtime directory created at: $TMPFS_RUNTIME"

if date +%s%N &>/dev/null; then
    EPHEMERAL_PROFILE="${TMPFS_RUNTIME}/profile-$(date +%s%N)"
else
    EPHEMERAL_PROFILE="${TMPFS_RUNTIME}/profile-$(date +%s)-$$-$RANDOM"
fi

# -------------------------------------------------------------------------
# Environment variables
# -------------------------------------------------------------------------
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export FONTCONFIG_PATH=/etc/fonts
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
[[ "${XDG_CURRENT_DESKTOP:-}" == "GNOME" ]] && export GNOME_DISABLE_CRASH_DIALOG=1

# Force C.UTF-8 to prevent bash/locale warnings regardless of system config
SYSTEM_LOCALE="C.UTF-8"
(( VERBOSE )) && echo "System Locale set to: $SYSTEM_LOCALE"

# -------------------------------------------------------------------------
# DBus session bus
# -------------------------------------------------------------------------
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]]; then
        DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
    else
        echo "Error: DBUS_SESSION_BUS_ADDRESS is not set and fallback socket not found" >&2
        exit 1
    fi
fi

# Preserve the real host session bus before replacing it for the sandbox
HOST_DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"

# -------------------------------------------------------------------------
# Start DBus proxy
# -------------------------------------------------------------------------
# Only org.freedesktop.portal.Desktop is a real bus name; the portal "names"
# (FileChooser, OpenURI, etc.) are interfaces on it. Grant visibility of that
# name and allow only the specific portal interfaces Signal needs (plus the
# async Request response and Settings change signals). org.freedesktop.secrets
# (keyring via libsecret) and the StatusNotifierWatcher names are real session
# bus services that Signal must reach directly, so grant them talk.
rm -f "$TMPFS_RUNTIME/signal-session.sock"

xdg-dbus-proxy "$HOST_DBUS_SESSION_BUS_ADDRESS" \
    "$TMPFS_RUNTIME/signal-session.sock" \
    --filter \
    --own=org.signal.* \
    --own=org.freedesktop.StatusNotifierItem-2-1 \
    --own=org.freedesktop.StatusNotifierItem-2-2 \
    --own=org.kde.StatusNotifierItem-2-1 \
    --own=org.kde.StatusNotifierItem-2-2 \
    --see=org.freedesktop.portal.Desktop \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.DBus.Properties.Get \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.FileChooser.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.OpenURI.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Settings.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Notification.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Clipboard.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Inhibit.* \
    --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Request.* \
    --broadcast=org.freedesktop.portal.Desktop=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/* \
    --broadcast=org.freedesktop.portal.Desktop=org.freedesktop.portal.Settings.*@/org/freedesktop/portal/desktop \
    --talk=org.freedesktop.Notifications \
    --talk=org.freedesktop.secrets \
    --talk=org.kde.StatusNotifierWatcher \
    --talk=org.freedesktop.StatusNotifierWatcher &

PROXY_PID=$!

timeout_ms=5000
elapsed_ms=0
while [[ ! -S "$TMPFS_RUNTIME/signal-session.sock" ]]; do
    sleep 0.1
    elapsed_ms=$((elapsed_ms + 100))

    if (( elapsed_ms >= timeout_ms )); then
        echo "Error: DBus proxy socket not created after $((timeout_ms/1000)) seconds" >&2
        kill "$PROXY_PID" 2>/dev/null
        exit 1
    fi
done

if ! kill -0 "$PROXY_PID" 2>/dev/null; then
    echo "Error: DBus proxy failed to start" >&2
    exit 1
fi

# -------------------------------------------------------------------------
# Identity files
# -------------------------------------------------------------------------
REAL_USER="${USER:-$(whoami)}"
echo "${REAL_USER}:x:$(id -u):$(id -g):${REAL_USER}:$SANDBOX:/bin/false" > "$TMPFS_RUNTIME/passwd"
echo "${REAL_USER}:x:$(id -g):" > "$TMPFS_RUNTIME/group"

machine_id=""
if command -v uuidgen &>/dev/null; then
    machine_id=$(uuidgen | tr -d '-')
else
    machine_id="deadbeef-$(id -u)-random"
fi
printf '%s' "$machine_id" > "$TMPFS_RUNTIME/machine-id"

# -------------------------------------------------------------------------
# Custom /etc/hosts
# -------------------------------------------------------------------------
{
    echo "127.0.0.1 localhost"
    echo "::1 localhost"
    grep -E '^\s*0\.0\.0\.0\s' /etc/hosts 2>/dev/null || true
} > "$TMPFS_RUNTIME/hosts"

# -------------------------------------------------------------------------
# Hardware Detection
# -------------------------------------------------------------------------
HAS_NVIDIA=false
[[ -e /dev/nvidia0 ]] && HAS_NVIDIA=true

HAS_AMD=false
if [[ -d /sys/class/drm ]]; then
    for card in /sys/class/drm/card*/device/driver; do
        if [[ -L "$card" ]]; then
            driver=$(basename "$(readlink "$card")")
            if [[ "$driver" == "amdgpu" || "$driver" == "radeon" ]]; then
                HAS_AMD=true
                break
            fi
        fi
    done
fi

HAS_INTEL=false
if [[ -d /sys/class/drm ]]; then
    for card in /sys/class/drm/card*/device/driver; do
        if [[ -L "$card" ]]; then
            driver=$(basename "$(readlink "$card")")
            if [[ "$driver" == "i915" ]]; then
                HAS_INTEL=true
                break
            fi
        fi
    done
fi

BWRAP_GPU=()
if [[ -d /dev/dri ]]; then
    shopt -s nullglob
    for dev in /dev/dri/render* /dev/dri/card*; do
        [[ -e "$dev" ]] && BWRAP_GPU+=(--dev-bind-try "$dev" "$dev")
    done
    shopt -u nullglob
fi

if [[ "$HAS_NVIDIA" == true ]]; then
    shopt -s nullglob
    for dev in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm /dev/nvidia-uvm-tools; do
        [[ -e "$dev" ]] && BWRAP_GPU+=(--dev-bind "$dev" "$dev")
    done
    for dev in /dev/nvidia-caps/*; do
        [[ -e "$dev" ]] && BWRAP_GPU+=(--dev-bind "$dev" "$dev")
    done
    shopt -u nullglob
fi

# -------------------------------------------------------------------------
# GPU Environment Variables
# -------------------------------------------------------------------------
BWRAP_GPU_ENV=()
find_va_driver_path() {
    local driver="$1"
    if [[ "$driver" == "nvidia" ]]; then
        for path in /usr/lib64/va/drivers /usr/lib/va/drivers /usr/lib/x86_64-linux-gnu/va/drivers /usr/lib64/dri /usr/lib/dri /usr/lib/x86_64-linux-gnu/dri; do
            [[ -f "$path/nvidia_drv_video.so" ]] && echo "$path" && return 0
        done
       else
        for path in /usr/lib64/dri /usr/lib/dri /usr/lib/x86_64-linux-gnu/dri /usr/lib/aarch64-linux-gnu/dri /usr/lib64/va/drivers /usr/lib/va/drivers; do
            [[ -f "$path/${driver}_drv_video.so" ]] && echo "$path" && return 0
        done
    fi
    return 1
}

NVIDIA_LIB_PATH=""
if [[ "$HAS_NVIDIA" == true ]]; then
    if [[ -f "/usr/lib64/libEGL_nvidia.so.0" ]]; then
        NVIDIA_LIB_PATH="/usr/lib64"
    elif [[ -d "/usr/lib64/nvidia" ]]; then
        NVIDIA_LIB_PATH="/usr/lib64/nvidia"
    fi

    NVIDIA_VA_PATH=$(find_va_driver_path nvidia)
    BWRAP_GPU_ENV=(
        --setenv __NV_PRIME_RENDER_OFFLOAD 1
        --setenv __NV_PRIME_RENDER_OFFLOAD_PROVIDER NVIDIA-G0
        --setenv __GLX_VENDOR_LIBRARY_NAME nvidia
        --setenv __VK_LAYER_NV_optimus NVIDIA_only
        --setenv GBM_BACKEND nvidia-drm
        --setenv LIBVA_DRIVER_NAME nvidia
        --setenv EGL_PLATFORM wayland
    )
    
    if [[ -n "$NVIDIA_LIB_PATH" ]]; then
        BWRAP_GPU_ENV+=(--setenv LD_LIBRARY_PATH "$NVIDIA_LIB_PATH:${LD_LIBRARY_PATH:-}")
        (( VERBOSE )) && echo "Injecting Nvidia Library Path: $NVIDIA_LIB_PATH"
    fi
    [[ -n "$NVIDIA_VA_PATH" ]] && BWRAP_GPU_ENV+=(--setenv LIBVA_DRIVERS_PATH "$NVIDIA_VA_PATH")

elif [[ "$HAS_INTEL" == true ]]; then
    INTEL_DRIVER=""
    find_va_driver_path iHD &>/dev/null && INTEL_DRIVER="iHD" || INTEL_DRIVER="i965"
    INTEL_VA_PATH=$(find_va_driver_path "${INTEL_DRIVER}")
    
    BWRAP_GPU_ENV=(
        --setenv EGL_PLATFORM wayland 
        --setenv LIBVA_DRIVER_NAME "$INTEL_DRIVER"
    )
    
    if [[ -n "$INTEL_VA_PATH" ]]; then
        BWRAP_GPU_ENV+=(--setenv LIBVA_DRIVERS_PATH "$INTEL_VA_PATH")
    fi

elif [[ "$HAS_AMD" == true ]]; then
    AMD_VA_PATH=$(find_va_driver_path radeonsi)
    BWRAP_GPU_ENV=(
        --setenv LIBVA_DRIVER_NAME radeonsi
    )
    if [[ -n "$AMD_VA_PATH" ]]; then
        BWRAP_GPU_ENV+=(--setenv LIBVA_DRIVERS_PATH "$AMD_VA_PATH")
    fi
fi

BWRAP_GRAPHICS_SHARES=(
    --ro-bind-try /usr/share/glvnd/egl_vendor.d /usr/share/glvnd/egl_vendor.d
    --ro-bind-try /etc/glvnd/egl_vendor.d /etc/glvnd/egl_vendor.d
    --ro-bind-try /usr/share/egl/egl_external_platform.d /usr/share/egl/egl_external_platform.d
    --ro-bind-try /etc/egl/egl_external_platform.d /etc/egl/egl_external_platform.d
    --ro-bind-try /usr/share/nvidia /usr/share/nvidia
    --ro-bind-try /usr/lib64/glvnd /usr/lib64/glvnd
    --ro-bind-try /usr/lib/glvnd /usr/lib/glvnd
    --ro-bind-try /usr/lib/x86_64-linux-gnu/glvnd /usr/lib/x86_64-linux-gnu/glvnd
    --ro-bind-try /usr/lib/i386-linux-gnu/glvnd /usr/lib/i386-linux-gnu/glvnd
    --ro-bind-try /usr/lib64/gbm /usr/lib64/gbm
    --ro-bind-try /usr/lib/gbm /usr/lib/gbm
    --ro-bind-try /usr/lib64/va /usr/lib64/va
    --ro-bind-try /usr/lib/va /usr/lib/va
    --ro-bind-try /usr/lib64/dri /usr/lib64/dri
    --ro-bind-try /usr/lib/dri /usr/lib/dri
    --ro-bind-try /usr/lib64/vulkan /usr/lib64/vulkan
    --ro-bind-try /usr/lib/vulkan /usr/lib/vulkan
    --ro-bind-try /usr/lib/x86_64-linux-gnu/vulkan /usr/lib/x86_64-linux-gnu/vulkan
    --ro-bind-try /usr/lib/i386-linux-gnu/vulkan /usr/lib/i386-linux-gnu/vulkan
    --ro-bind-try /etc/vulkan /etc/vulkan
    --ro-bind-try /usr/share/vulkan /usr/share/vulkan
)

BWRAP_PROC_GPU=()

if [[ -d /proc/driver/nvidia ]]; then
    BWRAP_PROC_GPU+=(
        --dir /proc/driver
        --dir /proc/driver/nvidia
        --ro-bind-try /proc/driver/nvidia/params /proc/driver/nvidia/params
        --ro-bind-try /proc/driver/nvidia/version /proc/driver/nvidia/version
    )
    shopt -s nullglob
    for gpu_dir in /proc/driver/nvidia/gpus/*; do
        [[ -d "$gpu_dir" ]] && BWRAP_PROC_GPU+=(--ro-bind-try "$gpu_dir" "$gpu_dir")
        [[ -f "$gpu_dir/information" ]] && BWRAP_PROC_GPU+=(--ro-bind-try "$gpu_dir/information" "$gpu_dir/information")
    done
    shopt -u nullglob
fi

if [[ "$HAS_INTEL" == true ]]; then
    BWRAP_PROC_GPU+=(--ro-bind-try /sys/module/i915 /sys/module/i915)
    BWRAP_PROC_GPU+=(--ro-bind-try /sys/class/drm /sys/class/drm)
fi

if [[ "$HAS_AMD" == true ]]; then
    BWRAP_PROC_GPU+=(--ro-bind-try /sys/module/amdgpu /sys/module/amdgpu)
    BWRAP_PROC_GPU+=(--ro-bind-try /sys/class/drm /sys/class/drm)
fi

BWRAP_LIBS=(--ro-bind-try /usr/lib /usr/lib)
[[ -d /usr/lib64 ]] && BWRAP_LIBS+=(--ro-bind /usr/lib64 /usr/lib64)
[[ -d /lib64 ]] && BWRAP_LIBS+=(--ro-bind /lib64 /lib64)
[[ -d /usr/lib/locale ]] && BWRAP_LIBS+=(--ro-bind /usr/lib/locale /usr/lib/locale)

BWRAP_MULTIARCH=()
shopt -s nullglob
for arch_dir in /usr/lib/*-linux-gnu; do
    [[ -d "$arch_dir" ]] && BWRAP_MULTIARCH+=(--ro-bind "$arch_dir" "$arch_dir")
done
shopt -u nullglob

# -------------------------------------------------------------------------
# AV Binds
# -------------------------------------------------------------------------
mkdir -p "$TMPFS_RUNTIME/pulse"
mkdir -p "$SANDBOX/.config/pulse"
BWRAP_AV=(
    --ro-bind-try "$XDG_RUNTIME_DIR/pulse/native" "$TMPFS_RUNTIME/pulse/native"
    --ro-bind-try "$HOME/.config/pulse/cookie" "$SANDBOX/.config/pulse/cookie"
)
shopt -s nullglob
for pw_socket in "$XDG_RUNTIME_DIR"/pipewire-*; do
    [[ -S "$pw_socket" ]] && BWRAP_AV+=(--bind-try "$pw_socket" "$TMPFS_RUNTIME/$(basename "$pw_socket")")
done
shopt -u nullglob
for dev in /dev/v4l2loopback /dev/video*; do
    [[ -e "$dev" ]] && BWRAP_AV+=(--dev-bind "$dev" "$dev")
done

# -------------------------------------------------------------------------
# Print Binds
# -------------------------------------------------------------------------
BWRAP_PRINT=(
    --ro-bind-try /etc/cups /etc/cups
    --bind-try /run/cups /run/cups
)

# -------------------------------------------------------------------------
# Sys Tree
# -------------------------------------------------------------------------
BWRAP_SYS=(
    --tmpfs /sys
    --ro-bind-try /sys/class/video4linux /sys/class/video4linux
    --ro-bind-try /sys/devices/virtual/video4linux /sys/devices/virtual/video4linux
    --ro-bind-try /sys/bus/pci /sys/bus/pci
    --ro-bind-try /sys/bus/pci/drivers/nvidia /sys/bus/pci/drivers/nvidia
    --ro-bind-try /sys/dev /sys/dev
    --ro-bind-try /sys/devices/system /sys/devices/system
    --ro-bind-try /sys/module/nvidia /sys/module/nvidia     
    --ro-bind-try /sys/module/nvidia_drm /sys/module/nvidia_drm
    --ro-bind-try /sys/module/nvidia_modeset /sys/module/nvidia_modeset
    --ro-bind-try /sys/module/nvidia_uvm /sys/module/nvidia_uvm
    --dir /sys/devices/virtual
    --dir /sys/devices/virtual/dmi
    --dir /sys/devices/virtual/dmi/id
)
shopt -s nullglob
for d in /sys/devices/pci*; do
    [[ -d "$d" ]] && BWRAP_SYS+=(--ro-bind-try "$d" "$d")
done
shopt -u nullglob

# -------------------------------------------------------------------------
# Wayland Socket
# -------------------------------------------------------------------------
BWRAP_WAYLAND=()
WAYLAND_SOCKET="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
SANDBOX_SOCKET="$TMPFS_RUNTIME/$WAYLAND_DISPLAY"

if [[ -S "$WAYLAND_SOCKET" ]]; then
    mkdir -p "$(dirname "$SANDBOX_SOCKET")"
    BWRAP_WAYLAND+=(--ro-bind "$WAYLAND_SOCKET" "$SANDBOX_SOCKET")
else
    echo "Error: Wayland socket not found at $WAYLAND_SOCKET" >&2
    exit 1
fi

# -------------------------------------------------------------------------
# Sandbox Dirs
# -------------------------------------------------------------------------
for dir in "$SANDBOX" "$SANDBOX/.local" "$SANDBOX/Downloads" "$SANDBOX/Documents" "$SANDBOX/Pictures" "$SANDBOX/Desktop"; do
    mkdir -p "$dir"
done

# -------------------------------------------------------------------------
# Build Input Method & GPU Env Array
# -------------------------------------------------------------------------
BWRAP_IM=()
if [[ -n "${GTK_IM_MODULE:-}" ]]; then
    BWRAP_IM+=(--setenv GTK_IM_MODULE "$GTK_IM_MODULE")
fi
if [[ -n "${QT_IM_MODULE:-}" ]]; then
    BWRAP_IM+=(--setenv QT_IM_MODULE "$QT_IM_MODULE")
fi
if [[ -n "${XMODIFIERS:-}" ]]; then
    BWRAP_IM+=(--setenv XMODIFIERS "$XMODIFIERS")
fi
if [[ "$HAS_NVIDIA" == true ]]; then
    BWRAP_IM+=(--setenv LIBVA_DRIVER_NAME nvidia)
fi

# -------------------------------------------------------------------------
# User Specific Binds (from ~/.local)
# -------------------------------------------------------------------------

# Ensure target directories exist in the sandbox so we can bind files into them
mkdir -p "$SANDBOX/.local/bin"
mkdir -p "$SANDBOX/.local/share/applications"

BWRAP_USER_BINDS=()

if [[ -f "$HOME/.local/bin/browse.sh" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/bin/browse.sh" "$SANDBOX/.local/bin/browse.sh")
fi
if [[ -f "$HOME/.local/share/applications/mpv-scheme-handler.desktop" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mpv-scheme-handler.desktop" "$SANDBOX/.local/share/applications/mpv-scheme-handler.desktop")
fi
if [[ -f "$HOME/.local/share/applications/my-url-handler.desktop" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/my-url-handler.desktop" "$SANDBOX/.local/share/applications/my-url-handler.desktop")
fi
# Check if it exists as a file OR a link
if [[ -f "$HOME/.local/share/applications/mimeapps.list" || -L "$HOME/.local/share/applications/mimeapps.list" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mimeapps.list" "$SANDBOX/.local/share/applications/mimeapps.list")
fi
if [[ -f "$HOME/.local/share/applications/mimeinfo.cache" ]]; then
    BWRAP_USER_BINDS+=(--ro-bind "$HOME/.local/share/applications/mimeinfo.cache" "$SANDBOX/.local/share/applications/mimeinfo.cache")
fi

# -------------------------------------------------------------------------
# Bwrap command construction
# -------------------------------------------------------------------------
bwrap \
    --die-with-parent \
    --unshare-ipc \
    --unshare-pid \
    --unshare-cgroup \
    --unshare-uts \
    --hostname localhost \
    --new-session \
    --setenv HOME "$SANDBOX" \
    --setenv XDG_CONFIG_HOME "$SANDBOX/.config" \
    --setenv XDG_RUNTIME_DIR "$TMPFS_RUNTIME" \
    --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$TMPFS_RUNTIME/signal-session.sock" \
    --setenv GTK_USE_PORTAL 1 \
    --setenv PATH "$PATH" \
    --setenv LANG "$SYSTEM_LOCALE" \
    --setenv LC_ALL "$SYSTEM_LOCALE" \
    --setenv TERM "${TERM:-xterm-256color}" \
    --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
    --setenv ELECTRON_OZONE_PLATFORM_HINT wayland \
    --setenv XDG_DOCUMENTS_DIR "$SANDBOX/Documents" \
    --setenv XDG_DOWNLOAD_DIR "$SANDBOX/Downloads" \
    --setenv XDG_PICTURES_DIR "$SANDBOX/Pictures" \
    --setenv XDG_DESKTOP_DIR "$SANDBOX/Desktop" \
    ${XDG_SESSION_TYPE:+--setenv XDG_SESSION_TYPE "$XDG_SESSION_TYPE"} \
    --setenv XDG_CURRENT_DESKTOP "${XDG_CURRENT_DESKTOP:-GNOME}" \
    --setenv XDG_CONFIG_DIRS "/etc/xdg" \
    --unsetenv DISPLAY \
    --unsetenv KDE_FULL_SESSION \
    --unsetenv KDE_SESSION_VERSION \
